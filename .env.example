# Run: uv run python scripts/configure_local.py
# The script creates .env with random local credentials.
DATABASE_URL=postgresql://agentrpg:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55432/agentrpg
POSTGRES_USER=agentrpg
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=agentrpg
POSTGRES_PORT=55432
# Optional native server storage. Use a local folder outside cloud sync.
# Empty uses .local/pgdata. This setting does not move an existing database.
AGENTRPG_PGDATA=
ADMIN_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
HOST=127.0.0.1
PORT=8000
# Optional API connection pool: POOL_MIN_SIZE (default 2).
# Optional API connection pool: POOL_MAX_SIZE (default 20).
# Optional API connection pool: POOL_TIMEOUT in seconds (default 5).
# Optional: required only when running real model Agents.
# It is the only provider key that the project keeps. See AGENTS.md.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Separate simulator models; command-line model options take precedence.
# OPENROUTER_ACTOR_MODEL is the default owner model of scripts/run_scenario.py,
# scripts/run_clocked.py and scripts/run_transfer_actors.py.
# OPENROUTER_DIRECTOR_MODEL is read only by scripts/author_scenario.py, as its author model.
# A clocked run (scripts/run_clocked.py) takes its Director model from --director-model, or else
# from the owner model. Give all three model options for a week run. See docs/EVENT_CLOCK.md.
OPENROUTER_ACTOR_MODEL=openai/gpt-4.1
OPENROUTER_DIRECTOR_MODEL=openai/gpt-4.1
# Optional settings that this file does not set. Each line names one.
# TEST_DATABASE_URL: a separate test database. Empty: scripts/test_local.py uses DATABASE_URL with _test added to the database name.
# AGENTRPG_ZEROCLAW: the path of the ZeroClaw program, for the trial backend in docs/ZEROCLAW_TRIAL.md. Export it in the shell.
# AGENTRPG_TEST_CHROMIUM: a specific Chromium build for the browser tests. See docs/RUN_CONSOLE.md.
# AGENTRPG_TEST_SCREENSHOTS: a folder where the browser tests save pictures.
# DEEPSEEK_API_KEY: read only for a model name of the form deepseek:model. The project does not keep this key.
# ANTHROPIC_API_KEY: read only for a model name of the form anthropic:model. The project does not keep this key.
# AGENTRPG_CONSOLE_ROOT: the console sets it for its own worker process. Do not set it by hand.
