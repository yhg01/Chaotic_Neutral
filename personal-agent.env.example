# Copy to .env.personal-agent.local and enter the OpenRouter key locally.
# This profile applies to new personal assistant runs only.
# Actors and reviewers keep the original .env and saved run configuration.
PERSONAL_AGENT_API_ENABLED=true
PERSONAL_AGENT_PROVIDER="openrouter"
PERSONAL_AGENT_MODEL="deepseek/deepseek-v3.2"
PERSONAL_AGENT_BASE_URL="https://openrouter.ai/api/v1"
PERSONAL_AGENT_API_KEY=""
