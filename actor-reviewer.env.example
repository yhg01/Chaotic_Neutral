# Copy to .env.actor-reviewer.local and enter the NEW OpenRouter key locally.
# Applies to both Actor and independent reviewer in the elapsed Clock runner.
# Personal Agents keep .env.personal-agent.local and DeepSeek V3.2.
# Use a funded account. Another key on the same low-balance account shares its credits.
ACTOR_REVIEWER_API_ENABLED=true
ACTOR_REVIEWER_PROVIDER="openrouter"
ACTOR_REVIEWER_BASE_URL="https://openrouter.ai/api/v1"
ACTOR_REVIEWER_MODEL="openai/gpt-4.1"
ACTOR_REVIEWER_API_KEY=""
