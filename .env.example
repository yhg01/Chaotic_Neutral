# Run: uv run python scripts/configure_local.py
# The script creates .env with random local credentials.
DATABASE_URL=postgresql://agentrpg:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55432/agentrpg
POSTGRES_USER=agentrpg
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=agentrpg
POSTGRES_PORT=55432
# Optional native server storage. Use a local folder outside cloud sync.
# Empty uses .local/pgdata. This setting does not move an existing database.
AGENTRPG_PGDATA=
ADMIN_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
HOST=127.0.0.1
PORT=8000
# Optional: required only when running real model Agents.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Separate simulator models; command-line model options take precedence.
OPENROUTER_ACTOR_MODEL=openai/gpt-4.1
OPENROUTER_DIRECTOR_MODEL=openai/gpt-4.1
